<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XsdVisualizer.App.ViewModels"
        xmlns:views="using:XsdVisualizer.App.Views"
        xmlns:core="using:XsdVisualizer.Core"
        xmlns:res="using:XsdVisualizer.App.Resources"
        x:Class="XsdVisualizer.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/app.png"
        Title="{x:Static res:Strings.AppTitle}"
        Width="1400" Height="850"
        DragDrop.AllowDrop="True">

    <Window.DataTemplates>
        <TreeDataTemplate DataType="vm:SchemaNodeViewModel" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Icon}" Opacity="0.6" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Cardinality}" Opacity="0.6" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding TypeName}" Opacity="0.6" FontSize="11" FontStyle="Italic" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Node.WildcardNamespace}" Opacity="0.6" FontSize="11" FontStyle="Italic" VerticalAlignment="Center"
                                               IsVisible="{Binding Node.WildcardNamespace, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <TextBlock Text="↻" IsVisible="{Binding IsRecursive}" VerticalAlignment="Center" />
                                    <ComboBox IsVisible="{Binding IsChoice}" ItemsSource="{Binding Branches}"
                                              SelectedIndex="{Binding PinnedBranch}" FontSize="11" Padding="4,0" MinHeight="22"
                                              ToolTip.Tip="{x:Static res:Strings.Branch}" />
                                </StackPanel>
                            </TreeDataTemplate>
    </Window.DataTemplates>

    <Window.Styles>
        <Style Selector="TreeView.schema TreeViewItem" x:DataType="vm:SchemaNodeViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Barra superior -->
        <Border DockPanel.Dock="Top" Padding="10,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <DockPanel>
                <!-- Marca -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8" Margin="2,0,18,0" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource SystemControlHighlightAccentBrush}">
                        <PathIcon Data="{StaticResource IconLogo}" Width="15" Height="15" Foreground="{DynamicResource OnAccentText}" />
                    </Border>
                    <TextBlock Text="{x:Static res:Strings.AppTitle}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Classes="toolbar" Click="OnSettingsClick" ToolTip.Tip="{x:Static res:Strings.Settings}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconSettings}" />
                        <TextBlock Text="{x:Static res:Strings.Settings}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Classes="toolbar" Click="OnAboutClick" ToolTip.Tip="{x:Static res:Strings.About}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconInfo}" />
                        <TextBlock Text="{x:Static res:Strings.AboutShort}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Classes="toolbar" Command="{Binding OpenFolderCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconFolderOpen}" />
                        <TextBlock Text="{x:Static res:Strings.OpenFolder}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="toolbar" Command="{Binding OpenXmlCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconFile}" />
                        <TextBlock Text="{x:Static res:Strings.OpenXml}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="toolbar" Command="{Binding CompareCommand}" ToolTip.Tip="{x:Static res:Strings.CompareTip}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconCompare}" />
                        <TextBlock Text="{x:Static res:Strings.Compare}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="toolbar" x:Name="RecentButton">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconHistory}" />
                        <TextBlock Text="{x:Static res:Strings.Recent}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                            <StackPanel Width="440" Spacing="2">
                                <TextBlock Text="{x:Static res:Strings.Recent}" FontWeight="SemiBold" Margin="10,4,10,6" Opacity="0.7" />
                                <TextBlock Text="{x:Static res:Strings.NoRecent}" Margin="10,0,10,6" Opacity="0.6"
                                           IsVisible="{Binding !Recent.Count}" />
                                <ItemsControl ItemsSource="{Binding Recent}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <!-- Conteúdo em TextBlock: texto direto no Button trata "_" como tecla de atalho e some com ele. -->
                                            <!-- Sem Command: fechar o flyout desliga o $parent[Window] antes de o comando rodar. -->
                                            <Button Classes="toolbar" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                    ToolTip.Tip="{Binding}" Click="OnRecentClick">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                    <PathIcon Data="{StaticResource IconFolder}" Foreground="{StaticResource FolderBrush}"
                                                              Width="20" Height="20" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Converter={x:Static views:PathConverters.FolderName}}"
                                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Converter={x:Static views:PathConverters.ParentFolder}}"
                                                                   FontSize="11" Opacity="0.6" TextTrimming="PrefixCharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            </DockPanel>
        </Border>

        <!-- Barra de status -->
        <Border DockPanel.Dock="Bottom" Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Width="120" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Larguras mínimas: o GridSplitter para nelas, e nada transborda para a coluna vizinha. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="420" MinWidth="400" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>
            <!-- Schema Sets e Global Elements -->
            <DockPanel Grid.Column="0" Margin="8" ClipToBounds="True">
                <TextBlock DockPanel.Dock="Top" Classes="caption" Text="{x:Static res:Strings.SchemaSets}" />
                <TreeView ItemsSource="{Binding SchemaSets}" SelectedItem="{Binding SelectedSchemaItem}">
                    <TreeView.DataTemplates>
                        <TreeDataTemplate DataType="vm:SchemaSetViewModel" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding Folder}">
                                <PathIcon Data="{StaticResource IconFolder}" Foreground="{StaticResource FolderBrush}"
                                          Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0" />
                                <StackPanel MaxWidth="160">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding LoadIssuesSummary}" Foreground="{DynamicResource WarningText}" FontSize="11"
                                               IsVisible="{Binding HasLoadIssues}">
                                        <ToolTip.Tip>
                                            <ItemsControl ItemsSource="{Binding LoadIssues}" MaxWidth="700" />
                                        </ToolTip.Tip>
                                    </TextBlock>
                                </StackPanel>
                                <Button Classes="icon" VerticalAlignment="Top"
                                        ToolTip.Tip="{x:Static res:Strings.ExportAll}"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ExportAllCommand}"
                                        CommandParameter="{Binding}">
                                    <PathIcon Data="{StaticResource IconDownload}" />
                                </Button>
                                <Button Classes="icon" VerticalAlignment="Top"
                                        ToolTip.Tip="{x:Static res:Strings.CloseSchemaSet}"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CloseSchemaSetCommand}"
                                        CommandParameter="{Binding}">
                                    <PathIcon Data="{StaticResource IconClose}" />
                                </Button>
                            </StackPanel>
                        </TreeDataTemplate>
                        <TreeDataTemplate DataType="vm:ServicesGroupViewModel" ItemsSource="{Binding Services}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconService}" Width="14" Height="14" Opacity="0.8" />
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </TreeDataTemplate>
                        <TreeDataTemplate DataType="vm:ServiceViewModel" ItemsSource="{Binding Operations}">
                            <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding SourceFileName}">
                                <PathIcon Data="{StaticResource IconService}" Width="14" Height="14"
                                          Foreground="{DynamicResource SystemControlHighlightAccentBrush}" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </StackPanel>
                        </TreeDataTemplate>
                        <DataTemplate DataType="vm:OperationViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconOperation}" Width="14" Height="14" Opacity="0.8" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="vm:GlobalElementViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding Namespace}">
                                <PathIcon Data="{StaticResource IconXsd}" Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
                                          Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </TreeView.DataTemplates>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

            <!-- Árvore do Global Element -->
            <Grid Grid.Column="2" Margin="8" RowDefinitions="Auto,Auto,Auto,*,4,Auto" ClipToBounds="True">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                    <TextBlock Text="{x:Static res:Strings.Generate}" VerticalAlignment="Center" Opacity="0.7" />
                    <Border Classes="segmented">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Command="{Binding GenerateMinimalCommand}" ToolTip.Tip="{x:Static res:Strings.MinimalTip}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource IconMinimal}" />
                                    <TextBlock Text="{x:Static res:Strings.Minimal}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding GenerateMaximalCommand}" ToolTip.Tip="{x:Static res:Strings.MaximalTip}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource IconMaximal}" />
                                    <TextBlock Text="{x:Static res:Strings.Maximal}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding GenerateCoverageSetCommand}" ToolTip.Tip="{x:Static res:Strings.CoverageTip}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource IconCoverage}" />
                                    <TextBlock Text="{x:Static res:Strings.CoverageSet}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBox Grid.Row="1" Classes="search" PlaceholderText="{x:Static res:Strings.SearchTree}" Text="{Binding SearchText}"
                         IsEnabled="{Binding HasSelectedElement}" IsVisible="{Binding ShowElementPanel}">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Escape" Command="{Binding ClearSearchCommand}" />
                    </TextBox.KeyBindings>
                    <TextBox.InnerLeftContent>
                        <PathIcon Classes="searchIcon" Data="{StaticResource IconSearch}" />
                    </TextBox.InnerLeftContent>
                    <TextBox.InnerRightContent>
                        <Button Classes="icon" Margin="0,0,4,0" Command="{Binding ClearSearchCommand}"
                                ToolTip.Tip="{x:Static res:Strings.ClearSearch}" IsVisible="{Binding HasSearchText}">
                            <PathIcon Data="{StaticResource IconClose}" Width="10" Height="10" />
                        </Button>
                    </TextBox.InnerRightContent>
                </TextBox>
                <StackPanel Grid.Row="2" Margin="0,6,0,0" Spacing="4" IsVisible="{Binding HasSearchText}">
                    <TextBlock Text="{Binding SearchSummary}" FontSize="11" Opacity="0.6" Margin="4,0" />
                    <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            ClipToBounds="True" IsVisible="{Binding SearchResults.Count}">
                        <ListBox Classes="results" MaxHeight="200" ItemsSource="{Binding SearchResults}"
                                 SelectedItem="{Binding SelectedSearchResult}" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SearchResultViewModel">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{Binding ParentPath}" FontSize="11" Opacity="0.6"
                                                   TextTrimming="PrefixCharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
                <Panel Grid.Row="3" Margin="0,6,0,0" IsVisible="{Binding ShowElementPanel}">
                    <TextBlock Text="{x:Static res:Strings.SelectElementHint}" Opacity="0.6"
                               IsVisible="{Binding !HasSelectedElement}" />
                    <TreeView Classes="schema" ItemsSource="{Binding TreeRoots}" />
                </Panel>

                <!-- Operation selecionada: Endpoint, Request/Response, Payload Binding e árvore do Payload -->
                <Panel Grid.Row="1" Grid.RowSpan="3" IsVisible="{Binding HasSelectedOperation}">
                <DockPanel DataContext="{Binding SelectedOperation}" x:DataType="vm:OperationViewModel">
                    <StackPanel DockPanel.Dock="Top" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconOperation}" Foreground="{DynamicResource SystemControlHighlightAccentBrush}" />
                            <TextBlock FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center">
                                <Run Text="{Binding ServiceName}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <Run Text=" / " Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <Run Text="{Binding Name}" />
                            </TextBlock>
                        </StackPanel>
                        <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                            <TextBlock Grid.Row="0" Text="{x:Static res:Strings.Endpoint}" VerticalAlignment="Center" Opacity="0.7" />
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <ComboBox ItemsSource="{Binding Endpoints}" SelectedItem="{Binding SelectedEndpoint}" HorizontalAlignment="Stretch" />
                                <TextBlock Text="{Binding Address}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" Margin="2,2,0,0" />
                                <TextBlock Text="{Binding SoapAction, StringFormat='soapAction: {0}'}" FontSize="11" Opacity="0.6"
                                           TextTrimming="PrefixCharacterEllipsis" Margin="2,0,0,0"
                                           IsVisible="{Binding SoapAction, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="{x:Static res:Strings.OperationLabel}" VerticalAlignment="Center" Opacity="0.7" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="16">
                                <RadioButton Content="{x:Static res:Strings.Request}" IsChecked="{Binding IsRequest}" GroupName="direction" />
                                <RadioButton Content="{x:Static res:Strings.Response}" IsChecked="{Binding IsResponse}" GroupName="direction" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="{x:Static res:Strings.BodyLabel}" Opacity="0.7" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BodyDescription}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="3" Text="{x:Static res:Strings.HeadersLabel}" Opacity="0.7" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding HeadersDescription}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="4" Text="{x:Static res:Strings.PayloadLabel}" VerticalAlignment="Center" Opacity="0.7" />
                            <AutoCompleteBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding PayloadChoices}"
                                             SelectedItem="{Binding SelectedPayload}" FilterMode="Contains" MinimumPrefixLength="0"
                                             PlaceholderText="{x:Static res:Strings.PayloadPlaceholder}">
                                <AutoCompleteBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GlobalElementChoice">
                                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </AutoCompleteBox.ItemTemplate>
                            </AutoCompleteBox>

                            <CheckBox Grid.Row="5" Grid.Column="1" Content="{x:Static res:Strings.Compressed}"
                                      IsChecked="{Binding Compressed}" IsVisible="{Binding CanCompress}" />
                        </Grid>
                        <TextBlock Text="{x:Static res:Strings.PayloadHint}" TextWrapping="Wrap" FontSize="12" Opacity="0.7"
                                   IsVisible="{Binding !HasPayload}" />
                    </StackPanel>
                    <TreeView Classes="schema" ItemsSource="{Binding PayloadTree}" Margin="0,8,0,0" />
                </DockPanel>
                </Panel>
                <GridSplitter Grid.Row="4" ResizeDirection="Rows" />
                <ScrollViewer Grid.Row="5" MaxHeight="280" DataContext="{Binding SelectedNode}" x:DataType="vm:SchemaNodeViewModel"
                              IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel>
                        <TextBlock Classes="caption" Text="{Binding Label}" FontSize="15" />
                        <TextBlock Text="{Binding Node.Path}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Foreground="{DynamicResource WarningText}"
                                   IsVisible="{Binding Notes, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Classes="caption" Text="{x:Static res:Strings.Type}" />
                        <SelectableTextBlock Text="{Binding TypeName}" />
                        <TextBlock Classes="caption" Text="{x:Static res:Strings.Cardinality}" />
                        <TextBlock Text="{Binding Cardinality}" />
                        <TextBlock Classes="caption" Text="{x:Static res:Strings.Fixed}"
                                   IsVisible="{Binding Node.FixedValue, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <SelectableTextBlock Text="{Binding Node.FixedValue}"
                                             IsVisible="{Binding Node.FixedValue, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Classes="caption" Text="{x:Static res:Strings.Facets}" IsVisible="{Binding HasFacets}" />
                        <SelectableTextBlock Text="{Binding FacetsText}" TextWrapping="Wrap" FontFamily="{DynamicResource MonospaceFont}"
                                             IsVisible="{Binding HasFacets}" />
                        <TextBlock Classes="caption" Text="{x:Static res:Strings.Documentation}"
                                   IsVisible="{Binding Documentation, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <SelectableTextBlock Text="{Binding Documentation}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <GridSplitter Grid.Column="3" ResizeDirection="Columns" />

            <!-- Editor -->
            <Panel Grid.Column="4" ClipToBounds="True">
                <TextBlock Text="{x:Static res:Strings.DropHint}" Opacity="0.5" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding !Tabs.Count}" />
                <TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" Padding="0">
                    <TabControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EditorTabViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="●" FontSize="10" IsVisible="{Binding IsDirty}" VerticalAlignment="Center" />
                                <Button Classes="icon" ToolTip.Tip="{x:Static res:Strings.CloseTab}"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CloseTabCommand}"
                                        CommandParameter="{Binding}">
                                    <PathIcon Data="{StaticResource IconClose}" Width="10" Height="10" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:EditorTabViewModel">
                            <views:XmlEditorView />
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </Panel>
        </Grid>
    </DockPanel>
</Window>
