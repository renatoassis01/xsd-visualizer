<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XsdVisualizer.App.ViewModels"
        xmlns:res="using:XsdVisualizer.App.Resources"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:views="using:XsdVisualizer.App.Views"
        x:Class="XsdVisualizer.App.Views.ComparisonWindow"
        x:DataType="vm:ComparisonViewModel"
        Title="{Binding Title}" Icon="/Assets/app.png"
        Width="1500" Height="900" WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.added"><Setter Property="Foreground" Value="{DynamicResource DiffAddedText}" /></Style>
        <Style Selector="TextBlock.removed"><Setter Property="Foreground" Value="{DynamicResource DiffRemovedText}" /></Style>
        <Style Selector="TextBlock.modified"><Setter Property="Foreground" Value="{DynamicResource DiffModifiedText}" /></Style>
        <Style Selector="TextBlock.removed.label"><Setter Property="TextDecorations" Value="Strikethrough" /></Style>
        <Style Selector="TextBlock.docOnly"><Setter Property="Opacity" Value="0.6" /></Style>
        <Style Selector="Ellipse.added"><Setter Property="Fill" Value="{DynamicResource DiffAddedText}" /></Style>
        <Style Selector="Ellipse.removed"><Setter Property="Fill" Value="{DynamicResource DiffRemovedText}" /></Style>
        <Style Selector="Ellipse.modified"><Setter Property="Fill" Value="{DynamicResource DiffModifiedText}" /></Style>
        <Style Selector="Ellipse.docOnly"><Setter Property="Fill" Value="{DynamicResource DiffModifiedText}" /><Setter Property="Opacity" Value="0.45" /></Style>
        <Style Selector="Ellipse.unchanged"><Setter Property="Fill" Value="Gray" /><Setter Property="Opacity" Value="0.4" /></Style>
        <Style Selector="TreeView.changes TreeViewItem" x:DataType="vm:ChangeNodeViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Barra: título, Minimal/Maximal, resumo -->
        <Border DockPanel.Dock="Top" Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                    <Button Classes="toolbar" Click="OnCopySummary">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconCopy}" />
                            <TextBlock Text="{x:Static res:Strings.CopySummary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="toolbar" Click="OnExportSummary">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconDownload}" />
                            <TextBlock Text="{x:Static res:Strings.ExportSummary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <!-- DockPanel (e não StackPanel) para o status ocupar só o espaço que sobra e não passar por baixo dos botões -->
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8" Margin="0,0,18,0">
                        <PathIcon Data="{StaticResource IconCompare}" Foreground="{DynamicResource SystemControlHighlightAccentBrush}" />
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="0,0,18,0">
                        <RadioButton Content="{x:Static res:Strings.Minimal}" IsChecked="{Binding UseMinimal}" GroupName="kind" />
                        <RadioButton Content="{x:Static res:Strings.Maximal}" IsChecked="{Binding !UseMinimal}" GroupName="kind" />
                    </StackPanel>
                    <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="120" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" Margin="0,0,18,0" />
                    <TextBlock Text="{Binding Status}" ToolTip.Tip="{Binding Status}" Opacity="0.7" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                </DockPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="400" MinWidth="300" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- Element Pairs -->
            <DockPanel Grid.Column="0" Margin="10" ClipToBounds="True">
                <!-- Título e filtro em linhas próprias, como na coluna de Changes: lado a lado, um cobria o outro -->
                <TextBlock DockPanel.Dock="Top" Classes="caption" Text="{x:Static res:Strings.Pairs}" Margin="0,0,0,6"
                           TextTrimming="CharacterEllipsis" />
                <CheckBox DockPanel.Dock="Top" Content="{x:Static res:Strings.OnlyChanged}" IsChecked="{Binding OnlyChangedPairs}"
                          FontSize="12" Margin="0,0,0,6" />
                <ListBox ItemsSource="{Binding Pairs}" SelectedItem="{Binding SelectedPair}">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem"><Setter Property="Padding" Value="8,5" /></Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ElementPairViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" ToolTip.Tip="{Binding StatusText}">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,6,0,0"
                                         Classes.added="{Binding Status, Converter={x:Static views:DiffConverters.IsAdded}}"
                                         Classes.removed="{Binding Status, Converter={x:Static views:DiffConverters.IsRemoved}}"
                                         Classes.modified="{Binding Status, Converter={x:Static views:DiffConverters.IsModified}}"
                                         Classes.docOnly="{Binding Status, Converter={x:Static views:DiffConverters.IsDocumentationOnly}}"
                                         Classes.unchanged="{Binding Status, Converter={x:Static views:DiffConverters.IsUnchanged}}"
                                         />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Files}" FontSize="11" Foreground="{DynamicResource MutedText}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="2" Classes="badge" VerticalAlignment="Top" Margin="0,1,0,0"
                                        Classes.added="{Binding Status, Converter={x:Static views:DiffConverters.IsAdded}}"
                                        Classes.removed="{Binding Status, Converter={x:Static views:DiffConverters.IsRemoved}}">
                                    <TextBlock Text="{Binding BadgeText}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

            <!-- Árvore de Changes + detalhes -->
            <Grid Grid.Column="2" Margin="10" RowDefinitions="Auto,Auto,*,4,Auto" ClipToBounds="True">
                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                        <Button Classes="icon" Command="{Binding PreviousChangeCommand}" ToolTip.Tip="{x:Static res:Strings.PreviousChange}">
                            <PathIcon Data="{StaticResource IconUp}" />
                        </Button>
                        <Button Classes="icon" Command="{Binding NextChangeCommand}" ToolTip.Tip="{x:Static res:Strings.NextChange}">
                            <PathIcon Data="{StaticResource IconDown}" />
                        </Button>
                    </StackPanel>
                    <TextBlock Classes="caption" Text="{x:Static res:Strings.Changes}" VerticalAlignment="Center" />
                </DockPanel>
                <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,6">
                    <!-- Resumo do par: quantas mudanças de cada tipo (texto além da cor) -->
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasSelectedPair}">
                        <Border Classes="badge modified" IsVisible="{Binding ModifiedCount}"><TextBlock Text="{Binding ModifiedCount, StringFormat={x:Static res:Strings.SummaryModified}}" /></Border>
                        <Border Classes="badge added" IsVisible="{Binding AddedCount}"><TextBlock Text="{Binding AddedCount, StringFormat={x:Static res:Strings.SummaryAdded}}" /></Border>
                        <Border Classes="badge removed" IsVisible="{Binding RemovedCount}"><TextBlock Text="{Binding RemovedCount, StringFormat={x:Static res:Strings.SummaryRemoved}}" /></Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <CheckBox Content="{x:Static res:Strings.OnlyChanges}" IsChecked="{Binding OnlyChanges}" FontSize="12" />
                        <CheckBox Content="{x:Static res:Strings.ShowDocumentation}" IsChecked="{Binding ShowDocumentation}" FontSize="12" />
                    </StackPanel>
                    <!-- Pesquisa no par selecionado; o tooltip explica o alcance (filtro, recursão, XML) -->
                    <TextBox x:Name="SearchBox" Classes="search" PlaceholderText="{x:Static res:Strings.SearchChanges}"
                             Text="{Binding SearchText}" IsEnabled="{Binding HasSelectedPair}"
                             ToolTip.Tip="{x:Static res:Strings.SearchChangesTip}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Escape" Command="{Binding ClearSearchCommand}" />
                        </TextBox.KeyBindings>
                        <TextBox.InnerLeftContent>
                            <PathIcon Classes="searchIcon" Data="{StaticResource IconSearch}" />
                        </TextBox.InnerLeftContent>
                        <TextBox.InnerRightContent>
                            <Panel>
                                <Button Classes="icon" Margin="0,0,4,0" Command="{Binding ClearSearchCommand}"
                                        ToolTip.Tip="{x:Static res:Strings.ClearSearch}" IsVisible="{Binding HasSearchText}">
                                    <PathIcon Data="{StaticResource IconClose}" Width="10" Height="10" />
                                </Button>
                                <Border Classes="kbd" IsVisible="{Binding !HasSearchText}">
                                    <TextBlock x:Name="SearchShortcut" />
                                </Border>
                            </Panel>
                        </TextBox.InnerRightContent>
                    </TextBox>
                    <StackPanel Spacing="4" IsVisible="{Binding HasSearchText}">
                        <TextBlock Text="{Binding SearchSummary}" FontSize="11" Foreground="{DynamicResource MutedText}"
                                   TextWrapping="Wrap" Margin="4,0" />
                        <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource SubtleBorder}"
                                ClipToBounds="True" IsVisible="{Binding SearchResults.Count}">
                            <ListBox Classes="results" MaxHeight="200" ItemsSource="{Binding SearchResults}"
                                     SelectedItem="{Binding SelectedSearchResult}" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChangeSearchResult">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="{Binding ParentPath}" FontSize="11" Foreground="{DynamicResource MutedText}"
                                                           TextTrimming="PrefixCharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Classes="badge" IsVisible="{Binding HasKind}"
                                                    Classes.added="{Binding IsAdded}" Classes.removed="{Binding IsRemoved}"
                                                    Classes.modified="{Binding IsModified}">
                                                <TextBlock Text="{Binding KindText}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <Panel Grid.Row="2">
                    <TextBlock Text="{x:Static res:Strings.SelectPairHint}" Opacity="0.6" IsVisible="{Binding !HasSelectedPair}" />
                    <TreeView Classes="changes" ItemsSource="{Binding TreeRoots}">
                        <TreeView.DataTemplates>
                            <TreeDataTemplate DataType="vm:ChangeNodeViewModel" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="label" Text="{Binding Label}" VerticalAlignment="Center"
                                               Classes.added="{Binding IsAdded}" Classes.removed="{Binding IsRemoved}"
                                               Classes.modified="{Binding IsModified}" Classes.docOnly="{Binding IsDocumentationOnly}" />
                                    <TextBlock Text="{Binding TypeName}" FontSize="11" FontStyle="Italic" Opacity="0.6" VerticalAlignment="Center" />
                                    <Border Classes="badge" IsVisible="{Binding CountText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            ToolTip.Tip="{Binding CountText}">
                                        <TextBlock Text="{Binding Count}" />
                                    </Border>
                                    <Border Classes="badge" IsVisible="{Binding HasBadge}"
                                            Classes.added="{Binding IsAdded}" Classes.removed="{Binding IsRemoved}" Classes.modified="{Binding IsModified}">
                                        <TextBlock Text="{Binding BadgeText}" />
                                    </Border>
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.DataTemplates>
                    </TreeView>
                </Panel>
                <GridSplitter Grid.Row="3" ResizeDirection="Rows" />
                <ScrollViewer Grid.Row="4" MaxHeight="320" VerticalAlignment="Top" DataContext="{Binding SelectedChange}" x:DataType="vm:ChangeNodeViewModel"
                              IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Spacing="8" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlHighlightAccentBrush}" />
                            <Border Classes="badge"
                                    Classes.added="{Binding IsAdded}" Classes.removed="{Binding IsRemoved}" Classes.modified="{Binding IsModified}">
                                <TextBlock Text="{Binding KindText}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Classes="section" Text="{x:Static res:Strings.Path}" />
                            <Border Classes="field">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Classes="icon" VerticalAlignment="Top" Margin="6,0,0,0"
                                            ToolTip.Tip="{x:Static res:Strings.CopyPath}" Click="OnCopyPathClick">
                                        <PathIcon Data="{StaticResource IconCopy}" />
                                    </Button>
                                    <SelectableTextBlock Text="{Binding Model.Path}" FontSize="11" TextWrapping="Wrap"
                                                         FontFamily="{DynamicResource MonospaceFont}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Differences}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DifferenceRow">
                                    <Border Classes="field">
                                        <StackPanel Spacing="2">
                                            <TextBlock Classes="section" Text="{Binding Name}" />
                                            <SelectableTextBlock TextWrapping="Wrap" FontFamily="{DynamicResource MonospaceFont}" FontSize="12"
                                                                 IsVisible="{Binding !IsEnumeration}">
                                                <Run Text="{Binding Before}" Foreground="{DynamicResource DiffRemovedText}" />
                                                <Run Text="  →  " Foreground="{DynamicResource MutedText}" />
                                                <Run Text="{Binding After}" Foreground="{DynamicResource DiffAddedText}" FontWeight="SemiBold" />
                                            </SelectableTextBlock>
                                            <SelectableTextBlock Text="{Binding Added}" TextWrapping="Wrap" FontFamily="{DynamicResource MonospaceFont}"
                                                                 FontSize="12" Foreground="{DynamicResource DiffAddedText}" IsVisible="{Binding HasAdded}" />
                                            <SelectableTextBlock Text="{Binding Removed}" TextWrapping="Wrap" FontFamily="{DynamicResource MonospaceFont}"
                                                                 FontSize="12" Foreground="{DynamicResource DiffRemovedText}" IsVisible="{Binding HasRemoved}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Spacing="2" IsVisible="{Binding HasDefinition}">
                            <TextBlock Classes="section" Text="{x:Static res:Strings.Definition}" />
                            <Border Classes="field">
                                <ItemsControl ItemsSource="{Binding Definition}" Grid.IsSharedSizeScope="True">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DefinitionRow">
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="name" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource MutedText}" Margin="0,0,12,0" />
                                                <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                                                                     FontFamily="{DynamicResource MonospaceFont}" FontSize="12" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="2" IsVisible="{Binding HasDocumentation}">
                            <TextBlock Classes="section" Text="{x:Static res:Strings.Documentation}" />
                            <SelectableTextBlock Text="{Binding Documentation}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <GridSplitter Grid.Column="3" ResizeDirection="Columns" />

            <!-- Lado a lado -->
            <Grid Grid.Column="4" ColumnDefinitions="*,1,*" RowDefinitions="Auto,Auto,*" ClipToBounds="True">
                <!-- Limitação do lado a lado, explicada onde ela aparece -->
                <Border Grid.Row="0" Grid.ColumnSpan="3" Padding="10,6" BorderThickness="0,0,0,1" x:Name="Hint"
                        Background="{DynamicResource SubtleBackground}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Classes="icon" VerticalAlignment="Top" Margin="8,0,0,0"
                                ToolTip.Tip="{x:Static res:Strings.HideHint}" Click="OnHideHint">
                            <PathIcon Data="{StaticResource IconClose}" Width="10" Height="10" />
                        </Button>
                        <PathIcon DockPanel.Dock="Left" Data="{StaticResource IconInfo}" Width="14" Height="14" Opacity="0.7"
                                  VerticalAlignment="Top" Margin="0,1,8,0" />
                        <TextBlock Text="{x:Static res:Strings.ComparisonHint}" TextWrapping="Wrap" FontSize="11" Opacity="0.75" />
                    </DockPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Padding="10,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <TextBlock>
                        <Run Text="{x:Static res:Strings.Before}" FontWeight="SemiBold" />
                        <Run Text="{Binding Before.Name, StringFormat='  {0}'}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </TextBlock>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" Padding="10,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="icon" x:Name="ShowHintButton" Padding="2"
                            ToolTip.Tip="{x:Static res:Strings.ShowHint}" Click="OnShowHint">
                        <PathIcon Data="{StaticResource IconInfo}" />
                    </Button>
                    <TextBlock>
                        <Run Text="{x:Static res:Strings.After}" FontWeight="SemiBold" />
                        <Run Text="{Binding After.Name, StringFormat='  {0}'}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </TextBlock>
                    </DockPanel>
                </Border>
                <ae:TextEditor Grid.Row="2" Grid.Column="0" x:Name="BeforeEditor" IsReadOnly="True" ShowLineNumbers="False"
                               Background="{DynamicResource EditorBackground}" Foreground="{DynamicResource EditorForeground}"
                               FontFamily="{DynamicResource MonospaceFont}" FontSize="12" HorizontalScrollBarVisibility="Auto" />
                <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                <ae:TextEditor Grid.Row="2" Grid.Column="2" x:Name="AfterEditor" IsReadOnly="True" ShowLineNumbers="False"
                               Background="{DynamicResource EditorBackground}" Foreground="{DynamicResource EditorForeground}"
                               FontFamily="{DynamicResource MonospaceFont}" FontSize="12" HorizontalScrollBarVisibility="Auto" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
