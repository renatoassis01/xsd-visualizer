<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:XsdVisualizer.App.Resources"
        x:Class="XsdVisualizer.App.Views.CompareDialog"
        Title="{x:Static res:Strings.CompareTitle}"
        Width="480" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Icon="/Assets/app.png">
    <StackPanel Margin="24" Spacing="14">
        <TextBlock Text="{x:Static res:Strings.CompareTitle}" FontSize="20" FontWeight="SemiBold" />
        <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto" RowSpacing="12">
            <TextBlock Grid.Row="0" Text="{x:Static res:Strings.Before}" VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="BeforeBox" HorizontalAlignment="Stretch" />
            <TextBlock Grid.Row="1" Text="{x:Static res:Strings.After}" VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="AfterBox" HorizontalAlignment="Stretch" />
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="CancelButton" Content="{x:Static res:Strings.Cancel}" IsCancel="True" />
            <Button x:Name="CompareButton" Classes="accent" Content="{x:Static res:Strings.Compare}" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
