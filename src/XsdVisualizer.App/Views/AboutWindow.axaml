<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:XsdVisualizer.App.Resources"
        x:Class="XsdVisualizer.App.Views.AboutWindow"
        Title="{x:Static res:Strings.About}"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="28" Spacing="10" HorizontalAlignment="Center">
        <Border Width="64" Height="64" CornerRadius="16" HorizontalAlignment="Center"
                Background="{DynamicResource SystemControlHighlightAccentBrush}">
            <PathIcon Data="{StaticResource IconLogo}" Width="34" Height="34" Foreground="White" />
        </Border>
        <TextBlock Text="{x:Static res:Strings.AppTitle}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock x:Name="Version" Opacity="0.6" HorizontalAlignment="Center" />
        <TextBlock Text="{x:Static res:Strings.AboutDescription}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" />
        <TextBlock Text="{x:Static res:Strings.AboutBuiltWith}" Opacity="0.6" FontSize="12" HorizontalAlignment="Center" />
        <Button x:Name="CloseButton" Classes="accent" Content="{x:Static res:Strings.Close}" HorizontalAlignment="Center"
                Margin="0,10,0,0" IsDefault="True" IsCancel="True" />
    </StackPanel>
</Window>
