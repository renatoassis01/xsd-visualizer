<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:XsdVisualizer.App.Resources"
             x:Class="XsdVisualizer.App.App"
             Name="XSD Visualizer"
             RequestedThemeVariant="Default">

    <!-- Menu do aplicativo no macOS. Precisa estar aqui (e não ser criado depois): o Avalonia lê o menu do
         Application na inicialização; sem ele, usa o padrão "About Avalonia". Os textos são trocados em App.axaml.cs. -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About" Click="OnAboutClick" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Settings" Gesture="Meta+OemComma" Click="OnSettingsClick" />
        </NativeMenu>
    </NativeMenu.Menu>

    <Application.Resources>
        <FontFamily x:Key="MonospaceFont">Menlo, Consolas, Cascadia Mono, DejaVu Sans Mono, monospace</FontFamily>

